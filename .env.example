# OBS WebSocket settings
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Optional second OBS machine/bridge
OBS_BRIDGE_HOST=
OBS_BRIDGE_PORT=4455
OBS_BRIDGE_PASSWORD=

# Twitch integration
TWITCH_CHANNEL=
TWITCH_NICK=
TWITCH_OAUTH_TOKEN=oauth:
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=

# Machine-specific asset paths
SOUNDBOARD_ASSETS_DIR=
SOUND_EFFECTS_DIR=
SONGS_ASSETS_DIR=
REPLAY_DIR=
TIKTOK_ASSETS_DIR=

# Voice / ASR
# WHISPER_MODEL can be a model name like large-v3 or a local model folder.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
WHISPER_LANGUAGE=en
MIC_DEVICE=1
MIC_SAMPLE_RATE=16000
MIC_CHUNK_SAMPLES=512
RMS_THRESHOLD=0.01
SPEECH_PAD_CHUNKS=20
MIN_SPEECH_CHUNKS=8
