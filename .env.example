# OBS WebSocket settings
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_obs_websocket_password

# OBS WebSocket settings for obs_bridge (invisible-lens machine)
OBS_BRIDGE_HOST=192.168.x.x
OBS_BRIDGE_PORT=4455
OBS_BRIDGE_PASSWORD=your_bridge_obs_password

# Twitch integration
TWITCH_OAUTH_TOKEN=oauth:your_twitch_oauth_token
TWITCH_CHANNEL=your_twitch_channel
TWITCH_NICK=your_bot_username

# Twitch app credentials (stream_title project — from dev.twitch.tv)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_BROADCASTER_ID=your_broadcaster_id

# Asset paths (machine-specific — use forward slashes)
SOUND_EFFECTS_DIR=C:/path/to/soundeffects
SONGS_ASSETS_DIR=C:/path/to/songs
REPLAY_DIR=C:/path/to/replays
TIKTOK_ASSETS_DIR=C:/path/to/tiktok
