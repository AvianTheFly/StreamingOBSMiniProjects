{
  "hub_hotkeys": {
    "abort_all_audio": {
      "enabled": false,
      "sequence": "",
      "max_interval": 0.8
    },
    "show_screen": {
      "enabled": true,
      "sequence": "*-",
      "max_interval": 0.8
    },
    "hide_screen": {
      "enabled": true,
      "sequence": "-*",
      "max_interval": 0.8
    }
  },
  "hub_workflows": [
    {
      "id": "keep_game_recording",
      "name": "Keep latest game recording",
      "enabled": true,
      "sequence": "*k*",
      "max_interval": 0.8,
      "steps": [
        {
          "kind": "project",
          "project": "league_api",
          "action": "keep_recording"
        }
      ]
    },
    {
      "id": "delete_game_recording",
      "name": "Delete latest game recording",
      "enabled": true,
      "sequence": "*d*",
      "max_interval": 0.8,
      "steps": [
        {
          "kind": "project",
          "project": "league_api",
          "action": "delete_recording"
        }
      ]
    },
    {
      "id": "mark_game_recording",
      "name": "Mark moment in game recording",
      "enabled": true,
      "sequence": "/*",
      "max_interval": 0.8,
      "steps": [
        {
          "kind": "project",
          "project": "league_api",
          "action": "mark_recording"
        }
      ]
    }
  ],
  "project_trigger_modes": {},
  "whisper_model": "small.en",
  "whisper_device": "cuda",
  "whisper_compute": "int8_float16",
  "whisper_language": "en",
  "mic_device": 1,
  "mic_sample_rate": 16000,
  "rms_threshold": 0.01
}