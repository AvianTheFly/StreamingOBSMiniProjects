    {
      "id": "league_stats.viewer_views",
      "label": "Present stats to streamer and viewers",
      "topic": "Chat & stats",
      "trigger": {
        "label": "Choose a stat view",
        "kind": "browser"
      },
      "detail": "Local overlay presets keep 520 by 190 dimensions, use whitelisted themes, and never write OBS state. Browser preview lifetime owns its polling; hidden previews are removed. Review drafts stay local until explicit Save and pending-save edits retain the updated revision. Aggregate coverage groups reported metrics in one archive pass instead of scanning every match twice per metric. Observed and completed values remain separate; missing statistics remain unknown, derived rates retain their original meaning, and source records are not mutated.",
      "steps": [
        {
          "id": "0",
          "label": "Choose dashboard filters",
          "owner": "league_stats",
          "kind": "control",
          "detail": ""
        },
        {
          "id": "1",
          "label": "Derive at most 12 completed games with stat gaps",
          "owner": "league_stats",
          "kind": "action",
          "detail": ""
        },
        {
          "id": "2",
          "label": "Compute goal pace only from fresh reported CS",
          "owner": "league_stats",
          "kind": "gate",
          "detail": ""
        },
        {
          "id": "3",
          "label": "Render chart and preview chosen overlay view",
          "owner": "hub",
          "kind": "output",
          "detail": ""
        },
        {
          "id": "4",
          "label": "Viewer card temporarily takes priority",
          "owner": "league_stats",
          "kind": "action",
          "detail": ""
        },
        {
          "id": "5",
          "label": "Return to selected or available rotating view",
          "owner": "hub",
          "kind": "end",
          "detail": " OBS requests only viewer fields, avoiding editor tables, charts and reply previews. Hidden documents and OBS sources cancel polling; returning starts a fresh request and rejects stale responses. Export reads the archive directly without building the desk report."
        }
