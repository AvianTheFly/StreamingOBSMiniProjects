    {
      "id": "instant_replay.play",
      "label": "Play a replay",
      "topic": "Replay playback",
      "trigger": {
        "label": "Play a replay",
        "event": "source.playback",
        "kind": "event"
      },
      "detail": "Explicit replay always selects Quick Replay. Short Move/Wipe/Fade handles entry and owned return; showcase retains its selected full transition. Browser handoff cues keep live/camera visible between clips. Offline and runtime management share the same inventory and linked-copy visibility.",
      "steps": [
        {
          "id": "0",
          "label": "Acquire physical playback gate",
          "owner": "coordination",
          "kind": "action",
          "detail": ""
        },
        {
          "id": "1",
          "label": "Reserve scene and scoped pause",
          "owner": "coordination",
          "kind": "action",
          "detail": ""
        },
        {
          "id": "2",
          "label": "Prepare decoder while game stays live",
          "owner": "media_workers",
          "kind": "wait",
          "detail": "Every clip decodes while hidden; handoff holds the next clip before it becomes audible or visible."
        },
        {
          "id": "3",
          "label": "Apply clip levels / first-frame hold",
          "owner": "instant_replay",
          "kind": "action",
          "detail": "Pause and seek, then confirm a stable first-frame cursor before showing it through entry or revealing the next clip. Resume only after the reveal acknowledgement."
        },
        {
          "id": "4",
          "label": "Quick entry or showcase transition",
          "owner": "obs",
          "kind": "output",
          "detail": ""
        },
        {
          "id": "5",
          "label": "Return only if still owner",
          "owner": "coordination",
          "kind": "gate",
          "detail": "Hold scoped pauses through the return transition. A newer manual scene choice prevents scene restoration and automatic resume."
        },
        {
          "id": "6",
          "label": "Release claim after final cleanup",
          "owner": "coordination",
          "kind": "end",
          "detail": "Park the physical source and restore captured audio before releasing the playback gate."
        }
      ],
