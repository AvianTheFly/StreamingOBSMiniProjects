      "effects": [
        {
          "resource": "scene",
          "intent": "Reserve a temporary replay presentation",
          "role": "reserve",
          "protection": "The reservation begins before loading. Owned cleanup restores the previous scene only while the lease is current.",
          "watch": "A second temporary presentation cannot reserve an already-owned scene. A manual choice revokes the lease.",
          "cases": {
            "normal": {
              "status": "ready",
              "text": "Can reserve an available scene before decoder preparation."
            },
            "result": {
              "status": "check",
              "text": "A result hold is not itself a scene lease. Replay admission and the existing temporary owner still decide whether playback can begin."
            },
            "temporary": {
              "status": "wait",
              "text": "A second temporary reservation is refused while a lease already exists."
            },
            "manual": {
              "status": "check",
              "text": "A manual choice revokes an earlier replay lease. A new replay request is a new intent and may reserve again."
            }
          }
        },
        {
          "resource": "audio",
          "intent": "Pause configured modules until replay cleanup",
          "role": "write",
          "protection": "Scoped pause claims stay held through final source cleanup. Finishing releases only this request."
        },
        {
          "resource": "source",
          "intent": "Play clips through one owned source worker",
          "role": "write",
          "protection": "Replacement cancels the old request, then waits for its final cleanup before source reuse."
        }
      ]
