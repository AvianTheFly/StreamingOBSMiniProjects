    {
      "id": "starting_soon.design",
      "label": "Apply a reusable visual look",
      "topic": "Waiting room",
      "trigger": {
        "label": "Save or apply a visual look",
        "event": "hub_action",
        "kind": "control"
      },
      "detail": "Artwork, editable copy, optional highlight frame, reveal style and drift are visual preferences. Named looks exclude playlists, clip placement overrides and volumes. Previews remain private; applying a look cannot start clips. Invalid personal data remains untouched, and unknown saved-look fields are preserved. Automatic rotation advances only during an owned waiting-room session; inactive ticks perform no file reads. Explicit artwork choices remain immediate, and re-entry starts a fresh rotation interval. Background status uses compact runtime/player state instead of rebuilding editor catalogs or copying the playlist.",
      "steps": [
        {
          "id": "0",
          "label": "Validate visual preferences",
          "owner": "starting_soon",
          "kind": "gate",
          "detail": "Validate the complete existing generation, named looks and proposed preferences."
        },
        {
          "id": "1",
          "label": "Snapshot and save atomically",
          "owner": "starting_soon",
          "kind": "action",
          "detail": "Revision checks reject stale editors. Merge unknown personal fields and keep playlists and clip placements."
        },
        {
          "id": "2",
          "label": "Update browser layers",
          "owner": "starting_soon",
          "kind": "output",
          "detail": "Artwork, transparent message and transparent frame have separate URLs. Two bounded image layers reject stale loads. Unchanged displays skip DOM/layout work. Off-scene artwork pauses, cancels the state request and owns no polling timer. Becoming visible immediately reads current state; responses from a hidden generation are ignored. Page exit cancels animation and transport. Highlight disable cancels playback through its existing owner."
        }
      ],
